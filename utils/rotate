#!/usr/bin/env python3
"""Replace one host-owned key. Git and deployment remain manual."""

import argparse
import contextlib
import json
import os
from pathlib import Path
import resource
import socket
import subprocess
import sys
import tempfile
import uuid

HOSTS = ("punky", "jasper", "blaze")
FIELDS = {"ssh": "ssh-client", "nix": "nix-signing", "passage": "passage-identity"}


class RotationError(Exception):
    pass


def run(args, data=None, *, binary=False, env=None):
    result = subprocess.run(
        [str(arg) for arg in args], input=data, text=not binary,
        stdout=subprocess.PIPE, stderr=subprocess.PIPE, env=env,
    )
    if result.returncode:
        raise RotationError(f"{args[0]} failed (exit {result.returncode})")
    return result.stdout


def root(args, data=None):
    return run(["doas", "env", f"PATH={os.environ['PATH']}", *args], data)


def atomic_write(path, contents, mode=0o644):
    path = Path(path)
    path.parent.mkdir(parents=True, exist_ok=True)
    descriptor, temporary = tempfile.mkstemp(prefix=".rotate-", dir=path.parent)
    try:
        with os.fdopen(descriptor, "wb" if isinstance(contents, bytes) else "w") as stream:
            stream.write(contents)
            stream.flush()
            os.fsync(stream.fileno())
        os.chmod(temporary, mode)
        os.replace(temporary, path)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


@contextlib.contextmanager
def private_workspace():
    if run(["findmnt", "-n", "-o", "FSTYPE", "--target", "/dev/shm"]).strip() != "tmpfs":
        raise RotationError("/dev/shm must be tmpfs")
    with tempfile.TemporaryDirectory(prefix="rotate-", dir="/dev/shm") as directory:
        yield Path(directory)


def public_for(kind, private):
    if kind in ("ssh", "passage"):
        with private_workspace() as directory:
            identity = directory / "identity"
            identity.write_text(private)
            command = (["ssh-keygen", "-y", "-P", "", "-f", identity] if kind == "ssh"
                       else ["age-keygen", "-y", identity])
            public = run(command).strip()
            return " ".join(public.split()[:2]) if kind == "ssh" else public
    if kind == "nix":
        return run(["nix", "key", "convert-secret-to-public"], private).strip()
    raise RotationError(f"unknown key kind: {kind}")


def generate(kind, identity):
    if kind == "ssh":
        with private_workspace() as directory:
            path = directory / "identity"
            run(["ssh-keygen", "-q", "-t", "ed25519", "-N", "", "-C", identity, "-f", path])
            private = path.read_text()
    elif kind == "nix":
        private = run(["nix", "key", "generate-secret", "--key-name", identity])
    elif kind == "passage":
        with private_workspace() as directory:
            path = directory / "identity"
            run(["age-keygen", "-o", path])
            private = path.read_text()
    else:
        raise RotationError(f"unknown key kind: {kind}")
    return private, public_for(kind, private)


def password_files(store):
    return [path for path in sorted(store.rglob("*.age"))
            if not path.is_symlink() and ".git" not in path.relative_to(store).parts]


def stage_passage_rotation(store, old_public, new_public, new_private):
    identity_file = Path("/run/secrets/rendered/passage-identities")
    if not identity_file.exists():
        raise RotationError("the deployed Passage identity is missing")
    recipient_files = [path for path in sorted(store.rglob(".age-recipients"))
                       if ".git" not in path.relative_to(store).parts]
    if not recipient_files:
        raise RotationError("no Passage recipient files found")

    recipients_by_directory = {}
    replacements = {}
    for path in recipient_files:
        recipients = path.read_text().split()
        updated = [new_public if item == old_public else item for item in recipients]
        recipients_by_directory[path.parent] = updated
        if updated != recipients:
            replacements[path] = "\n".join(dict.fromkeys(updated)) + "\n"
    if not replacements:
        raise RotationError("this host's current public key is not a Passage recipient")

    with private_workspace() as directory:
        new_identity = directory / "identity"
        new_identity.write_text(new_private)
        staged = []
        try:
            for source in password_files(store):
                parent = source.parent
                while parent not in recipients_by_directory and parent != store:
                    parent = parent.parent
                if parent not in recipients_by_directory:
                    raise RotationError(f"no recipients found for {source}")
                recipients = recipients_by_directory[parent]
                if new_public not in recipients:
                    continue
                plaintext = run([
                    "age", "--decrypt", "--identity", identity_file, source
                ], binary=True)
                args = ["age", "--encrypt"]
                for recipient in recipients:
                    args.extend(["--recipient", recipient])
                encrypted = run(args, plaintext, binary=True)
                verified = run([
                    "age", "--decrypt", "--identity", new_identity
                ], encrypted, binary=True)
                if verified != plaintext:
                    raise RotationError(f"verification failed for {source}")
                temporary = source.with_name(source.name + ".rotating")
                atomic_write(temporary, encrypted, mode=0o600)
                staged.append((source, temporary))
            if not staged:
                raise RotationError("no password entries use this host's recipient")
            return staged, replacements
        except Exception:
            for _, temporary in staged:
                temporary.unlink(missing_ok=True)
            raise


class Rotation:
    def __init__(self, repo, host, kind, store=None):
        self.repo = Path(repo)
        self.host = host
        self.kind = kind
        self.store = Path(store) if store else Path.home() / ".password-store"
        if host not in HOSTS:
            raise RotationError(f"run this on {', '.join(HOSTS)}")
        self.field = FIELDS[kind]
        self.secret_file = self.repo / "secrets" / f"{host}.json"
        self.public_file = self.repo / "keys" / kind / f"{host}.pub"

    def decrypt(self):
        return json.loads(root([
            "SOPS_AGE_KEY_FILE=/cold/age/key.agekey", "sops", "decrypt", self.secret_file
        ]))

    def encrypt(self, values):
        recipient = (self.repo / "keys" / "age" / f"{self.host}.pub").read_text().strip()
        encrypted = run([
            "sops", "encrypt", "--input-type", "json", "--output-type", "json",
            "--filename-override", f"{self.host}.json", "--age", recipient,
        ], json.dumps(values))
        document = json.loads(encrypted)
        if "sops" not in document or document["sops"]["age"][0]["recipient"] != recipient:
            raise RotationError("SOPS used an unexpected recipient")
        if any(not isinstance(value, str) or not value.startswith("ENC[AES256_GCM,")
               for key, value in document.items() if key != "sops"):
            raise RotationError("SOPS did not encrypt every secret")
        atomic_write(self.secret_file, encrypted)

    def rotate(self):
        values = self.decrypt()
        if self.field not in values or not self.public_file.exists():
            raise RotationError(f"missing active {self.kind} key")
        transition_fields = [name for name in values if name.startswith(self.field + "-")]
        transition_files = list(self.public_file.parent.glob(f"{self.host}-*.pub"))
        if transition_fields or transition_files:
            raise RotationError("remove unfinished next/old rotation state first")
        old_private = values[self.field]
        old_public = self.public_file.read_text().strip()
        if public_for(self.kind, old_private) != old_public:
            raise RotationError("active private and public keys do not match")

        identity = f"{self.host}-{self.kind}-{uuid.uuid4().hex[:12]}"
        new_private, new_public = generate(self.kind, identity)
        passage_changes = None
        if self.kind == "passage":
            passage_changes = stage_passage_rotation(
                self.store, old_public, new_public, new_private
            )

        values[self.field] = new_private
        self.encrypt(values)
        atomic_write(self.public_file, new_public + "\n")
        if passage_changes:
            staged, recipient_files = passage_changes
            for source, temporary in staged:
                os.replace(temporary, source)
            for path, contents in recipient_files.items():
                atomic_write(path, contents, mode=0o600)

        print(f"Replaced {self.host}'s {self.kind} key. Git was not touched.")
        if self.kind == "passage":
            print(f"Re-encrypted and verified {len(passage_changes[0])} password entries.")
        elif self.kind == "nix":
            print("After deployment, sign existing paths with the new key as documented.")
        else:
            print("Rebuild the other hosts first and this host last.")

    def status(self):
        encrypted = json.loads(self.secret_file.read_text())
        transition = sorted(name for name in encrypted if name.startswith(self.field + "-"))
        print(f"{self.host} {self.kind}: active={'yes' if self.field in encrypted else 'no'}, "
              f"public={'yes' if self.public_file.exists() else 'no'}")
        if transition:
            print(f"  unfinished fields: {', '.join(transition)}")


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("kind", choices=FIELDS)
    parser.add_argument("action", nargs="?", default="rotate", choices=("rotate", "status"))
    parser.add_argument("--store", type=Path, default=Path.home() / ".password-store")
    args = parser.parse_args()
    repo = Path(__file__).resolve().parent.parent
    if os.geteuid() == 0:
        raise RotationError("run as danielbarter; doas is used only for the encrypted host file")
    if os.environ.get("NIXOS_ROTATE_SHELL") != "1":
        os.execvp("nix", ["nix", "develop", f"{repo}#secrets", "--command", "env",
                           "NIXOS_ROTATE_SHELL=1", "python3", str(Path(__file__).resolve()), *sys.argv[1:]])
    os.umask(0o077)
    resource.setrlimit(resource.RLIMIT_CORE, (0, 0))
    rotation = Rotation(repo, socket.gethostname(), args.kind, args.store)
    getattr(rotation, args.action)()


if __name__ == "__main__":
    try:
        main()
    except (RotationError, OSError, ValueError, KeyError, json.JSONDecodeError) as error:
        message = str(error) if isinstance(error, RotationError) else type(error).__name__
        print(f"rotate: {message}", file=sys.stderr)
        sys.exit(1)
