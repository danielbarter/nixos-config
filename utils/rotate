#!/usr/bin/env python3
"""Rotate this host's keys without Git or private-key exchange."""

import argparse
import contextlib
import json
import os
from pathlib import Path
import resource
import socket
import subprocess
import sys
import tempfile
import uuid

HOSTS = ("punky", "jasper", "blaze")
FIELDS = {"ssh": "ssh-client", "nix": "nix-signing", "passage": "passage-identity"}


class RotationError(Exception):
    pass


def run(args, data=None, *, binary=False, visible=False, env=None):
    result = subprocess.run(
        [str(arg) for arg in args], input=data, text=not binary,
        stdout=None if visible else subprocess.PIPE,
        stderr=None if visible else subprocess.PIPE, env=env,
    )
    if result.returncode:
        raise RotationError(f"{args[0]} failed (exit {result.returncode})")
    return result.stdout


def root(args, data=None, *, visible=False):
    return run(["doas", "env", f"PATH={os.environ['PATH']}", *args], data, visible=visible)


def atomic_write(path, contents, mode=0o644):
    path = Path(path)
    path.parent.mkdir(parents=True, exist_ok=True)
    descriptor, temporary = tempfile.mkstemp(prefix=".rotate-", dir=path.parent)
    try:
        with os.fdopen(descriptor, "wb" if isinstance(contents, bytes) else "w") as stream:
            stream.write(contents)
            stream.flush()
            os.fsync(stream.fileno())
        os.chmod(temporary, mode)
        os.replace(temporary, path)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


@contextlib.contextmanager
def private_workspace():
    if run(["findmnt", "-n", "-o", "FSTYPE", "--target", "/dev/shm"]).strip() != "tmpfs":
        raise RotationError("/dev/shm must be tmpfs")
    with tempfile.TemporaryDirectory(prefix="rotate-", dir="/dev/shm") as directory:
        yield Path(directory)


def public_for(kind, private):
    if kind in ("ssh", "passage"):
        with private_workspace() as directory:
            path = directory / "identity"
            path.write_text(private)
            command = (["ssh-keygen", "-y", "-P", "", "-f", path] if kind == "ssh"
                       else ["age-keygen", "-y", path])
            public = run(command).strip()
            return " ".join(public.split()[:2]) if kind == "ssh" else public
    if kind == "nix":
        return run(["nix", "key", "convert-secret-to-public"], private).strip()
    raise RotationError(f"unknown key kind: {kind}")


def generate(kind, identity):
    if kind == "ssh":
        with private_workspace() as directory:
            path = directory / "identity"
            run(["ssh-keygen", "-q", "-t", "ed25519", "-N", "", "-C", identity, "-f", path])
            private = path.read_text()
    elif kind == "nix":
        private = run(["nix", "key", "generate-secret", "--key-name", identity])
    elif kind == "passage":
        with private_workspace() as directory:
            path = directory / "identity"
            run(["age-keygen", "-o", path])
            private = path.read_text()
    else:
        raise RotationError(f"unknown key kind: {kind}")
    return private, public_for(kind, private)


class Rotation:
    def __init__(self, repo, host, kind):
        self.repo = Path(repo)
        self.host = host
        self.kind = kind
        if host not in HOSTS:
            raise RotationError(f"run this on {', '.join(HOSTS)}")
        self.field = FIELDS[kind]
        self.secret_file = self.repo / "secrets" / f"{host}.json"
        self.key_dir = self.repo / "keys" / kind
        self.public = self.key_dir / f"{host}.pub"
        self.next_public = self.key_dir / f"{host}-next.pub"
        self.old_public = self.key_dir / f"{host}-old.pub"

    def decrypt(self):
        return json.loads(root([
            "SOPS_AGE_KEY_FILE=/cold/age/key.agekey", "sops", "decrypt", self.secret_file
        ]))

    def encrypt(self, values):
        recipient = (self.repo / "keys" / "age" / f"{self.host}.pub").read_text().strip()
        encrypted = run([
            "sops", "encrypt", "--input-type", "json", "--output-type", "json",
            "--filename-override", f"{self.host}.json", "--age", recipient,
        ], json.dumps(values))
        document = json.loads(encrypted)
        if "sops" not in document or document["sops"]["age"][0]["recipient"] != recipient:
            raise RotationError("SOPS used an unexpected recipient")
        if any(not isinstance(value, str) or not value.startswith("ENC[AES256_GCM,")
               for key, value in document.items() if key != "sops"):
            raise RotationError("SOPS did not encrypt every secret")
        atomic_write(self.secret_file, encrypted)

    def add(self):
        values = self.decrypt()
        if self.field + "-next" in values or self.field + "-old" in values:
            raise RotationError("finish this host's current rotation first")
        if self.kind != "passage" and self.field not in values:
            raise RotationError(f"{self.field} is missing")
        if self.next_public.exists() or self.old_public.exists():
            raise RotationError("unexpected next/old public key file")
        identity = f"{self.host}-{self.kind}-{uuid.uuid4().hex[:12]}"
        private, public = generate(self.kind, identity)
        values[self.field + "-next"] = private
        self.encrypt(values)
        atomic_write(self.next_public, public + "\n")
        print(f"Added a new {self.kind} key for {self.host}; the current key remains active.")
        print("Distribute the encrypted secret and public key, then rebuild every host before apply.")

    def verify_ssh(self, private):
        with private_workspace() as directory:
            identity = directory / "identity"
            identity.write_text(private)
            options = [
                "-F", "/dev/null", "-o", "BatchMode=yes", "-o", "ConnectTimeout=10",
                "-o", "StrictHostKeyChecking=accept-new", "-o", "IdentityAgent=none",
                "-o", "IdentitiesOnly=yes", "-i", str(identity),
            ]
            for host in HOSTS:
                try:
                    system = run(["ssh", *options, f"danielbarter@{host}",
                                  "readlink -f /run/current-system"]).strip()
                    run(["nix", "path-info", "--store", f"ssh://nix-ssh@{host}", system],
                        env=dict(os.environ, NIX_SSHOPTS=" ".join(options)))
                except RotationError as error:
                    raise RotationError(f"new SSH key is not accepted by {host}") from error

    def verify_nix(self, public):
        for host in HOSTS:
            output = run([
                "ssh", "-F", "/dev/null", "-o", "BatchMode=yes", "-o", "ConnectTimeout=10",
                "-o", "StrictHostKeyChecking=accept-new", "-o", "IdentityAgent=none",
                "-o", "IdentitiesOnly=yes", "-i", "/run/secrets/ssh-client",
                f"danielbarter@{host}",
                "nix config show --json",
            ])
            if public not in json.loads(output)["trusted-public-keys"]["value"]:
                raise RotationError(f"new Nix key is not trusted by {host}")
        deployed = Path(f"/run/secrets/{self.field}-next")
        if not deployed.exists() or public_for("nix", root(["cat", deployed])) != public:
            raise RotationError("rebuild this host with the next Nix key before apply")
        root(["nix", "store", "sign", "--all", "--key-file", deployed], visible=True)

    def apply(self):
        values = self.decrypt()
        next_field = self.field + "-next"
        if next_field not in values or not self.next_public.exists():
            raise RotationError("run add first")
        if self.field + "-old" in values or self.old_public.exists():
            raise RotationError("an old key is already waiting for retirement")
        expected = self.next_public.read_text().strip()
        if public_for(self.kind, values[next_field]) != expected:
            raise RotationError("next private and public keys do not match")
        if self.kind == "ssh":
            self.verify_ssh(values[next_field])
        elif self.kind == "nix":
            self.verify_nix(expected)
        else:
            identities = Path("/run/secrets/rendered/passage-identities")
            if not identities.exists():
                raise RotationError("rebuild this host with the Passage identity before apply")
            deployed = {
                public_for("passage", line + "\n")
                for line in identities.read_text().splitlines()
                if line.startswith("AGE-SECRET-KEY-")
            }
            if expected not in deployed:
                raise RotationError("rebuild this host with the next Passage identity before apply")
        if self.field in values:
            values[self.field + "-old"] = values[self.field]
        values[self.field] = values.pop(next_field)
        if self.public.exists():
            os.replace(self.public, self.old_public)
        os.replace(self.next_public, self.public)
        self.encrypt(values)
        print(f"Applied the new {self.kind} key for {self.host}.")
        if self.kind == "passage" and self.old_public.exists():
            print("Run passage reencrypt before retire.")
        else:
            print("Distribute the changes and rebuild every host before retire.")

    def retire(self):
        values = self.decrypt()
        old_field = self.field + "-old"
        if old_field not in values:
            print("No old key to retire on this host.")
            return
        if self.kind == "passage":
            old = self.old_public.read_text().strip()
            store = Path(os.environ.get("PASSAGE_DIR", Path.home() / ".password-store"))
            for recipients in store.rglob(".age-recipients"):
                if ".git" not in recipients.relative_to(store).parts and old in recipients.read_text().split():
                    raise RotationError(f"old recipient remains in {recipients}; run passage reencrypt")
        values.pop(old_field)
        self.encrypt(values)
        self.old_public.unlink(missing_ok=True)
        print(f"Retired the old {self.kind} key for {self.host}.")
        print("Distribute the changes and rebuild every host to complete revocation.")

    def cleanup_gpg(self):
        if self.kind != "passage":
            raise RotationError("cleanup-gpg is only for Passage")
        values = self.decrypt()
        if "pass-gpg" not in values:
            print("The old GPG export is already absent.")
            return
        values.pop("pass-gpg")
        self.encrypt(values)
        print(f"Removed the old GPG export from {self.secret_file}.")

    def status(self):
        encrypted = json.loads(self.secret_file.read_text())
        print(f"{self.host} {self.kind}:")
        for suffix, path in (("active", self.public), ("next", self.next_public),
                             ("old", self.old_public)):
            field = self.field if suffix == "active" else f"{self.field}-{suffix}"
            print(f"  {suffix}: secret={'yes' if field in encrypted else 'no'}, "
                  f"public={'yes' if path.exists() else 'no'}")


def password_files(store, suffix):
    return [path for path in sorted(store.rglob(f"*{suffix}"))
            if not path.is_symlink() and ".git" not in path.relative_to(store).parts]


def passage_recipients(repo):
    paths = [repo / "keys" / "passage" / f"{host}.pub" for host in HOSTS]
    if any(not path.exists() for path in paths):
        raise RotationError("all three active Passage public keys are required")
    recipients = [path.read_text().strip() for path in paths]
    if len(set(recipients)) != len(HOSTS) or any(not item.startswith("age1") for item in recipients):
        raise RotationError("Passage public keys are missing, duplicate, or invalid")
    return recipients


def stage_age_files(entries, recipients_for, identity_file, decrypt):
    staged = []
    try:
        for source in entries:
            target, recipients = recipients_for(source)
            if target.exists():
                raise RotationError(f"refusing to overwrite {target}")
            plaintext = decrypt(source)
            args = ["age", "--encrypt"]
            for recipient in recipients:
                args.extend(["--recipient", recipient])
            encrypted = run(args, plaintext, binary=True)
            if run(["age", "--decrypt", "--identity", identity_file], encrypted, binary=True) != plaintext:
                raise RotationError(f"verification failed for {source}")
            temporary = target.with_name(target.name + ".migrating")
            atomic_write(temporary, encrypted, mode=0o600)
            staged.append((source, target, temporary))
        return staged
    except Exception:
        for _, _, temporary in staged:
            temporary.unlink(missing_ok=True)
        raise


def migrate_passage(repo, store):
    identity_file = Path("/run/secrets/rendered/passage-identities")
    if not identity_file.exists():
        raise RotationError("rebuild this host with its Passage identity first")
    gpg_ids = [path for path in sorted(store.rglob(".gpg-id"))
               if ".git" not in path.relative_to(store).parts]
    entries = password_files(store, ".gpg")
    if not gpg_ids or not entries:
        raise RotationError("no GPG password store found")
    recipients = passage_recipients(repo)
    staged = stage_age_files(
        entries, lambda source: (source.with_suffix(".age"), recipients), identity_file,
        lambda path: run(["gpg", "--batch", "--decrypt", path], binary=True),
    )
    for source, target, temporary in staged:
        os.replace(temporary, target)
        source.unlink()
    recipient_text = "\n".join(recipients) + "\n"
    for gpg_id in gpg_ids:
        atomic_write(gpg_id.with_name(".age-recipients"), recipient_text, mode=0o600)
        gpg_id.unlink()
    attributes = store / ".gitattributes"
    if attributes.exists():
        lines = [line for line in attributes.read_text().splitlines()
                 if not line.lstrip().startswith("*.gpg")]
        lines.append("*.age diff=age")
        atomic_write(attributes, "\n".join(dict.fromkeys(lines)) + "\n")
    print(f"Converted and verified {len(staged)} passwords. Git was not touched.")


def reencrypt_passage(rotation, store):
    if not rotation.old_public.exists() or not rotation.public.exists():
        raise RotationError("apply the Passage rotation first")
    identity_file = Path("/run/secrets/rendered/passage-identities")
    old = rotation.old_public.read_text().strip()
    new = rotation.public.read_text().strip()
    recipient_files = [path for path in sorted(store.rglob(".age-recipients"))
                       if ".git" not in path.relative_to(store).parts]
    if not recipient_files:
        raise RotationError("no Passage recipient files found")
    mapping = {}
    for path in recipient_files:
        recipients = path.read_text().split()
        mapping[path.parent] = [new if item == old else item for item in recipients]

    def recipients_for(source):
        parent = source.parent
        while parent not in mapping and parent != store:
            parent = parent.parent
        if parent not in mapping:
            raise RotationError(f"no recipients found for {source}")
        return source.with_name(source.name + ".new"), mapping[parent]

    entries = password_files(store, ".age")
    staged = stage_age_files(
        entries, recipients_for, identity_file,
        lambda path: run(["age", "--decrypt", "--identity", identity_file, path], binary=True),
    )
    for source, _, temporary in staged:
        os.replace(temporary, source)
    for directory, recipients in mapping.items():
        atomic_write(directory / ".age-recipients",
                     "\n".join(dict.fromkeys(recipients)) + "\n", mode=0o600)
    print(f"Re-encrypted and verified {len(staged)} passwords. Git was not touched.")


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("kind", choices=FIELDS)
    parser.add_argument("phase", nargs="?", default="status",
                        choices=("add", "apply", "retire", "status", "migrate", "reencrypt", "cleanup-gpg"))
    parser.add_argument("--store", type=Path, default=Path.home() / ".password-store")
    args = parser.parse_args()
    if args.phase in ("migrate", "reencrypt", "cleanup-gpg") and args.kind != "passage":
        parser.error(f"{args.phase} is only for Passage")
    repo = Path(__file__).resolve().parent.parent
    if os.geteuid() == 0:
        raise RotationError("run as danielbarter; doas is used only for the encrypted host file")
    if os.environ.get("NIXOS_ROTATE_SHELL") != "1":
        os.execvp("nix", ["nix", "develop", f"{repo}#secrets", "--command", "env",
                           "NIXOS_ROTATE_SHELL=1", "python3", str(Path(__file__).resolve()), *sys.argv[1:]])
    os.umask(0o077)
    resource.setrlimit(resource.RLIMIT_CORE, (0, 0))
    rotation = Rotation(repo, socket.gethostname(), args.kind)
    if args.phase == "migrate":
        migrate_passage(repo, args.store)
    elif args.phase == "reencrypt":
        reencrypt_passage(rotation, args.store)
    else:
        getattr(rotation, args.phase.replace("-", "_"))()


if __name__ == "__main__":
    try:
        main()
    except (RotationError, OSError, ValueError, KeyError, json.JSONDecodeError) as error:
        message = str(error) if isinstance(error, RotationError) else type(error).__name__
        print(f"rotate: {message}", file=sys.stderr)
        sys.exit(1)
