#!/usr/bin/env bash
set -euo pipefail
umask 077

usage() {
  echo "usage: doas env PATH=\"\$PATH\" $0 /path/to/pass-secret-key.asc" >&2
  exit 2
}

[[ $# == 1 ]] || usage
[[ $EUID == 0 ]] || { echo "run this migration as root" >&2; exit 1; }

repo=$(git -C "$(dirname -- "${BASH_SOURCE[0]}")/.." rev-parse --show-toplevel)
host=$(hostname)
case "$host" in jasper|punky|blaze) ;; *) echo "unsupported host: $host" >&2; exit 1 ;; esac

gpg_export=$1
[[ -r $gpg_export ]] || { echo "cannot read GPG export: $gpg_export" >&2; exit 1; }
grep -q '^-----BEGIN PGP PRIVATE KEY BLOCK-----$' "$gpg_export" || {
  echo "the GPG export is not an armored private-key export" >&2
  exit 1
}

for command in age-keygen jq nix sops wg; do
  command -v "$command" >/dev/null || { echo "missing command: $command" >&2; exit 1; }
done

encrypted="$repo/secrets/$host.json"
[[ ! -e $encrypted ]] || { echo "$encrypted already exists; refusing to overwrite it" >&2; exit 1; }

remounted=false
restore_mount() {
  if $remounted; then
    mount -o remount,ro /cold || echo "warning: could not remount /cold read-only" >&2
    remounted=false
  fi
}
work=
cleanup() {
  restore_mount
  if [[ -n $work ]]; then
    rm -f "$work/plain.json" "$work/plain.next" "$work/encrypted.json" \
      "$work/age.pub" "$work/nix.pub" "$work/wg.pub"
    rmdir "$work" 2>/dev/null || true
  fi
}
trap cleanup EXIT

age_private=/cold/age/key.agekey
if [[ ! -e $age_private ]]; then
  mount -o remount,rw /cold
  remounted=true
  install -d -m 0700 /cold/age
  age-keygen -o "$age_private"
  chmod 0600 "$age_private"
fi
host_recipient=$(age-keygen -y "$age_private")
for public_key in "$repo"/keys/age/*.pub; do
  [[ -e $public_key ]] || continue
  [[ $public_key == "$repo/keys/age/$host.pub" ]] && continue
  if [[ $(tr -d '\n' < "$public_key") == "$host_recipient" ]]; then
    echo "this age identity is already assigned to $(basename "$public_key")" >&2
    echo "each /cold drive needs a unique age identity" >&2
    exit 1
  fi
done

repo_uid=$(stat -c %u "$repo")
repo_gid=$(stat -c %g "$repo")
install_public() {
  local source=$1 destination=$2
  install -d -m 0755 -o "$repo_uid" -g "$repo_gid" "$(dirname -- "$destination")"
  if [[ -e $destination ]]; then
    cmp -s "$source" "$destination" || {
      echo "public value differs from existing $destination" >&2
      exit 1
    }
  else
    install -m 0644 -o "$repo_uid" -g "$repo_gid" "$source" "$destination"
  fi
}

runtime=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}
[[ -d $runtime ]] || runtime=/dev/shm
work=$(mktemp -d "$runtime/nixos-secret-migration.XXXXXX")

printf '%s\n' "$host_recipient" > "$work/age.pub"
install_public "$work/age.pub" "$repo/keys/age/$host.pub"
install_public /cold/public/ssh/id_rsa.pub "$repo/keys/ssh/legacy.pub"
install_public /cold/public/ssh/phone.pub "$repo/keys/ssh/phone.pub"
nix key convert-secret-to-public < /cold/secrets/nix/private-key > "$work/nix.pub"
install_public "$work/nix.pub" "$repo/keys/nix/signing.pub"

for password_file in /cold/secrets/user_password_hash /cold/secrets/root_password_hash; do
  password_hash=$(tr -d '\n' < "$password_file")
  [[ $password_hash == \$* || $password_hash == \!* || $password_hash == \** ]] || {
    echo "$password_file does not look like a password hash or locked-password marker" >&2
    exit 1
  }
done

jq -n \
  --rawfile user_password /cold/secrets/user_password_hash \
  --rawfile root_password /cold/secrets/root_password_hash \
  --rawfile ssh_client /cold/secrets/ssh/id_rsa \
  --rawfile pass_gpg "$gpg_export" \
  --rawfile nix_signing /cold/secrets/nix/private-key \
  '{
    "user-password": ($user_password | rtrimstr("\n")),
    "root-password": ($root_password | rtrimstr("\n")),
    "ssh-client": $ssh_client,
    "pass-gpg": $pass_gpg,
    "nix-signing": $nix_signing
  }' > "$work/plain.json"

if [[ $host == blaze ]]; then
  install_public /cold/public/wireguard/phone "$repo/keys/wireguard/phone.pub"
  wg pubkey < /cold/secrets/wireguard/blaze > "$work/wg.pub"
  install_public "$work/wg.pub" "$repo/keys/wireguard/blaze.pub"
  jq \
    --rawfile wireguard /cold/secrets/wireguard/blaze \
    --rawfile duckdns /cold/secrets/duckdns_token \
    '. + {
      wireguard: ($wireguard | rtrimstr("\n")),
      duckdns: ($duckdns | rtrimstr("\n"))
    }' "$work/plain.json" > "$work/plain.next"
  mv "$work/plain.next" "$work/plain.json"
fi

sops encrypt --input-type json --output-type json \
  --age "$host_recipient" \
  "$work/plain.json" > "$work/encrypted.json"
SOPS_AGE_KEY_FILE=$age_private sops decrypt "$work/encrypted.json" >/dev/null
install -m 0644 -o "$repo_uid" -g "$repo_gid" "$work/encrypted.json" "$encrypted"

echo "Created secrets/$host.json and public keys for $host."
echo "Review and commit them, then build and switch this host."
